"""
SimplCore Tensor version — 版本信息（自研，零框架依赖）
兼容 torch.version（含 hip 属性用于 ROCm 检测）。
"""
from __future__ import annotations


class _Version:
    """版本命名空间，模拟 torch.version。

    hip 属性为 None 表示非 ROCm 环境；在检测到 AMD GPU 时可被置为版本字符串。
    """

    __version__: str = "2.0.0+simplcore-native"
    short_version: str = "2.0.0"
    hip: str = None  # ROCm 构建时为版本字符串（如 "5.7.0"），否则为 None
    git_version: str = "simplcore-native"

    def __repr__(self) -> str:
        return f"<SimplCoreTensorVersion {self.__version__}>"


version = _Version()
