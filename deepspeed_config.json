{
  "train_batch_size": 16,
  "train_micro_batch_size_per_gpu": 2,
  "gradient_accumulation_steps": 8,
  "optimizer": {
    "type": "MuonClipW",
    "params": {
      "lr": 3e-4,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.1,
      "clip_value": 10.0,
      "adaptive_lr": true
    }
  },
  "scheduler": {
    "type": "CosineAnnealingLR",
    "params": {
      "T_max": 100000,
      "eta_min": 3e-5
    }
  },
  "zero_optimization": {
    "stage": 3,
    "offload_optimizer": {
      "device": "cpu"
    },
    "offload_param": {
      "device": "cpu"
    },
    "overlap_comm": true,
    "reduce_scatter": true,
    "contiguous_gradients": true,
    "sub_group_size": 1e9,
    "max_live_parameters": 1e9,
    "max_reuse_distance": 1e9,
    "gather_16bit_weights_on_model_save": true
  },
  "gradient_clipping": 1.0,
  "fp16": {
    "enabled": false
  },
  "bf16": {
    "enabled": true
  },
  "logging": {
    "steps_per_print": 10,
    "gradient_accumulation_steps": 8
  },
  "checkpoint": {
    "load_universal": false,
    "save_universal": false
  },
  "communication_data_type": "bf16",
  "pin_memory": true,
  "steps_per_print": 10,
  "steps_per_synchronize": 8
}
